{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "tekivex-3d": ["../packages/tekivex-3d/src/index.ts"],
      "three": ["node_modules/@types/three/index.d.ts"],
      "three/*": ["node_modules/@types/three/*"]
    }
  },
  "include": ["src"]
}
